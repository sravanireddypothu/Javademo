pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/sravanireddypothu/Javademo.git'
            }
        }

        stage('Compile') {
            steps {
                dir('hello-app') {
                    bat 'mvn compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('hello-app') {
                    bat 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('hello-app') {
                    bat 'mvn package'
                }
            }
        }
    }
}