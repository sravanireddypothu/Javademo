pipeline{
    agent any
    tools{
        jdk 'JDK21'
        maven 'Maven'
    }
    stages{
        stage('Checkout'){
            steps{
                git branch:'main',
                url:'https://github.com/sravanireddypothu/Javademo.git'
            }
        }
        stage('compile'){
            steps{
                bat 'mvn compile'
            }
        }
        stage('Test'){
             steps{
                bat 'mvn test'
             }
        }
        stage('package'){
            steps{
                bat 'mvn package'
            }
        }
    }
}